# Envío del informe E2E por correo (utils/emailReporter.ts). Copiar a .env y completar SMTP_PASS.
# Google Workspace: SMTP_PASS es una "contraseña de aplicación" de 16 caracteres
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones),
# no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cramos@baseglobal.com.ar
SMTP_PASS=
MAIL_FROM=cramos@baseglobal.com.ar
MAIL_TO=cramos@baseglobal.com.ar
# EMAIL_REPORT=off   # desactiva el envío (igual escribe test-results/resumen-ejecucion.json)
